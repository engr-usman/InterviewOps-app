generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INTERVIEWER
}

enum OrgRole {
  OWNER
  ADMIN
  INTERVIEWER
  VIEWER
}

enum PlanCode {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum InterviewStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  STAFF
  PRINCIPAL
}

enum DifficultyLevel {
  BEGINNER
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  HEAD_ARCHITECT
}

enum QuestionType {
  FIXED
  AI_GENERATED
  FOLLOW_UP
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  BORDERLINE
  NO_HIRE
  STRONG_NO_HIRE
}

enum SourceType {
  RESUME
  JOB_DESCRIPTION
  MANUAL
  AI
}

enum RequirementType {
  REQUIRED
  PREFERRED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  SYSTEM
  INTERVIEW
  REPORT
  SECURITY
}

enum ReportType {
  FEEDBACK
  SCORECARD
  SUMMARY
  FULL
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  role                 UserRole  @default(INTERVIEWER)
  activeOrganizationId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  activeOrganization         Organization?        @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  organizationMemberships    OrganizationMember[] @relation("OrganizationMemberUser")
  invitedOrganizationMembers OrganizationMember[] @relation("OrganizationMemberInvitedBy")
  createdOrganizations       Organization[]       @relation("OrganizationCreatedBy")
  createdInviteTokens        InviteToken[]        @relation("InviteTokenCreatedBy")

  createdCandidates      Candidate[]      @relation("CandidateCreatedBy")
  createdJobDescriptions JobDescription[] @relation("JobDescriptionCreatedBy")
  createdInterviews      Interview[]      @relation("InterviewCreatedBy")
  assignedInterviews     Interview[]      @relation("InterviewAssignedInterviewer")
  notifications          Notification[]
  auditLogs              AuditLog[]
  updatedSettings        AppSetting[]     @relation("AppSettingUpdatedBy")

  @@index([email])
  @@index([activeOrganizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logoUrl     String?
  industry    String?
  companySize String?
  website     String?
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy     User                 @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members       OrganizationMember[]
  subscriptions Subscription[]
  invites       InviteToken[]

  candidates      Candidate[]
  jobDescriptions JobDescription[]
  interviews      Interview[]
  reports         Report[]
  users           User[]

  @@index([slug])
  @@index([createdById])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(INTERVIEWER)
  invitedById    String?
  joinedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrganizationMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("OrganizationMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model SubscriptionPlan {
  id                String   @id @default(cuid())
  code              PlanCode @unique
  name              String
  description       String?
  priceMonthlyCents Int?
  featuresJson      Json?
  limitsJson        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  metadataJson       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([planId])
}

model InviteToken {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole  @default(VIEWER)
  token          String   @unique
  expiresAt      DateTime
  createdById    String?
  metadataJson   Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("InviteTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

model Candidate {
  id             String          @id @default(cuid())
  createdById    String
  organizationId String?
  fullName       String
  email          String?
  phone          String?
  location       String?
  seniorityLevel SeniorityLevel?
  linkedInUrl    String?
  githubUrl      String?

  resumeFileUrl    String?
  resumeFileName   String?
  resumeMimeType   String?
  resumeUploadedAt DateTime?
  parsedResumeJson Json?
  tagsJson         Json?
  aiMetadataJson   Json?
  metadataJson     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy    User                  @relation("CandidateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  interviews   Interview[]
  skillMatches CandidateSkillMatch[]

  @@unique([organizationId, email])
  @@index([email])
  @@index([createdById])
  @@index([organizationId])
}

model JobDescription {
  id             String          @id @default(cuid())
  createdById    String
  organizationId String?
  title          String
  department     String?
  location       String?
  seniorityLevel SeniorityLevel?

  descriptionText  String?
  requirementsText String?
  parsedJdJson     Json?
  tagsJson         Json?
  aiMetadataJson   Json?
  metadataJson     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy         User                             @relation("JobDescriptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  organization      Organization?                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skillRequirements JobDescriptionSkillRequirement[]
  interviews        Interview[]

  @@index([createdById])
  @@index([organizationId])
}

model Skill {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  category    String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateMatches CandidateSkillMatch[]
  jdRequirements   JobDescriptionSkillRequirement[]

  @@index([slug])
}

model CandidateSkillMatch {
  id             String     @id @default(cuid())
  candidateId    String
  skillId        String
  sourceType     SourceType @default(RESUME)
  confidence     Float?
  evidenceText   String?
  aiMetadataJson Json?
  metadataJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId, sourceType])
  @@index([candidateId])
  @@index([skillId])
}

model JobDescriptionSkillRequirement {
  id               String          @id @default(cuid())
  jobDescriptionId String
  skillId          String
  requirementType  RequirementType @default(REQUIRED)
  priority         Priority        @default(MEDIUM)
  weight           Int?
  notesText        String?
  aiMetadataJson   Json?
  metadataJson     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  skill          Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobDescriptionId, skillId, requirementType])
  @@index([jobDescriptionId])
  @@index([skillId])
}

model Interview {
  id               String          @id @default(cuid())
  createdById      String
  organizationId   String?
  candidateId      String
  jobDescriptionId String
  assignedInterviewerId String?
  status           InterviewStatus @default(DRAFT)

  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  meetingUrl       String?
  notesText        String?
  aiMetadataJson   Json?
  metadataJson     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy      User                 @relation("InterviewCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedInterviewer User?           @relation("InterviewAssignedInterviewer", fields: [assignedInterviewerId], references: [id], onDelete: SetNull)
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate      Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobDescription JobDescription       @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  questions      InterviewQuestion[]
  scorecard      EvaluationScorecard?
  reports        Report[]

  @@index([status])
  @@index([candidateId])
  @@index([jobDescriptionId])
  @@index([createdById])
  @@index([organizationId])
  @@index([assignedInterviewerId])
}

model QuestionBank {
  id             String          @id @default(cuid())
  topic          String
  prompt         String
  type           QuestionType    @default(FIXED)
  difficulty     DifficultyLevel @default(MID_LEVEL)
  seniorityLevel SeniorityLevel?
  sourceType     SourceType      @default(MANUAL)
  tagsJson       Json?
  aiMetadataJson Json?
  metadataJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviewQuestions InterviewQuestion[]

  @@index([topic])
  @@index([difficulty])
}

model InterviewQuestion {
  id             String  @id @default(cuid())
  interviewId    String
  questionBankId String?

  order          Int
  topic          String?
  questionText   String
  type           QuestionType    @default(FIXED)
  difficulty     DifficultyLevel @default(MID_LEVEL)
  tagsJson       Json?
  aiMetadataJson Json?
  metadataJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview    Interview                    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionBank QuestionBank?                @relation(fields: [questionBankId], references: [id], onDelete: SetNull)
  evaluation   InterviewQuestionEvaluation?

  @@unique([interviewId, order])
  @@index([interviewId])
}

model InterviewQuestionEvaluation {
  id                  String  @id @default(cuid())
  interviewQuestionId String  @unique
  score               Int?
  notesText           String?
  aiMetadataJson      Json?
  metadataJson        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviewQuestion InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Cascade)
}

model EvaluationScorecard {
  id             String          @id @default(cuid())
  interviewId    String          @unique
  recommendation Recommendation?
  overallScore   Float?
  summaryText    String?
  scorecardJson  Json?
  aiMetadataJson Json?
  metadataJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model Report {
  id             String     @id @default(cuid())
  interviewId    String
  organizationId String?
  type           ReportType @default(FEEDBACK)
  title          String
  reportJson     Json
  aiMetadataJson Json?
  metadataJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview    Interview     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([type])
  @@index([organizationId])
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType @default(SYSTEM)
  priority     Priority         @default(MEDIUM)
  title        String
  message      String?
  readAt       DateTime?
  metadataJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([type])
}

model AuditLog {
  id           String  @id @default(cuid())
  userId       String
  action       String
  entityType   String
  entityId     String?
  ipAddress    String?
  userAgent    String?
  metadataJson Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
}

model AppSetting {
  id           String  @id @default(cuid())
  key          String  @unique
  settingValue Json
  description  String?
  isSystem     Boolean @default(false)
  updatedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedBy User? @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([key])
}
