generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INTERVIEWER
}

enum InterviewStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  STAFF
  PRINCIPAL
}

enum DifficultyLevel {
  BEGINNER
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  HEAD_ARCHITECT
}

enum QuestionType {
  FIXED
  AI_GENERATED
  FOLLOW_UP
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  BORDERLINE
  NO_HIRE
  STRONG_NO_HIRE
}

enum SourceType {
  RESUME
  JOB_DESCRIPTION
  MANUAL
  AI
}

enum RequirementType {
  REQUIRED
  PREFERRED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  SYSTEM
  INTERVIEW
  REPORT
  SECURITY
}

enum ReportType {
  FEEDBACK
  SCORECARD
  SUMMARY
  FULL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(INTERVIEWER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  createdCandidates      Candidate[]      @relation("CandidateCreatedBy")
  createdJobDescriptions JobDescription[] @relation("JobDescriptionCreatedBy")
  createdInterviews      Interview[]      @relation("InterviewCreatedBy")
  notifications          Notification[]
  auditLogs              AuditLog[]
  updatedSettings        AppSetting[]     @relation("AppSettingUpdatedBy")

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Candidate {
  id             String          @id @default(cuid())
  createdById    String
  fullName       String
  email          String?
  phone          String?
  location       String?
  seniorityLevel SeniorityLevel?
  linkedInUrl    String?
  githubUrl      String?

  resumeFileUrl    String?
  resumeFileName   String?
  resumeMimeType   String?
  resumeUploadedAt DateTime?
  parsedResumeJson Json?
  tagsJson         Json?
  aiMetadataJson   Json?
  metadataJson     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy    User                  @relation("CandidateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  interviews   Interview[]
  skillMatches CandidateSkillMatch[]

  @@index([email])
  @@index([createdById])
}

model JobDescription {
  id             String          @id @default(cuid())
  createdById    String
  title          String
  department     String?
  location       String?
  seniorityLevel SeniorityLevel?

  descriptionText  String?
  requirementsText String?
  parsedJdJson     Json?
  tagsJson         Json?
  aiMetadataJson   Json?
  metadataJson     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy         User                             @relation("JobDescriptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  skillRequirements JobDescriptionSkillRequirement[]
  interviews        Interview[]

  @@index([createdById])
}

model Skill {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  category    String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateMatches CandidateSkillMatch[]
  jdRequirements   JobDescriptionSkillRequirement[]

  @@index([slug])
}

model CandidateSkillMatch {
  id             String     @id @default(cuid())
  candidateId    String
  skillId        String
  sourceType     SourceType @default(RESUME)
  confidence     Float?
  evidenceText   String?
  aiMetadataJson Json?
  metadataJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId, sourceType])
  @@index([candidateId])
  @@index([skillId])
}

model JobDescriptionSkillRequirement {
  id               String          @id @default(cuid())
  jobDescriptionId String
  skillId          String
  requirementType  RequirementType @default(REQUIRED)
  priority         Priority        @default(MEDIUM)
  weight           Int?
  notesText        String?
  aiMetadataJson   Json?
  metadataJson     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  skill          Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobDescriptionId, skillId, requirementType])
  @@index([jobDescriptionId])
  @@index([skillId])
}

model Interview {
  id               String          @id @default(cuid())
  createdById      String
  candidateId      String
  jobDescriptionId String
  status           InterviewStatus @default(DRAFT)

  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  meetingUrl       String?
  notesText        String?
  aiMetadataJson   Json?
  metadataJson     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy      User                 @relation("InterviewCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  candidate      Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobDescription JobDescription       @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  questions      InterviewQuestion[]
  scorecard      EvaluationScorecard?
  reports        Report[]

  @@index([status])
  @@index([candidateId])
  @@index([jobDescriptionId])
  @@index([createdById])
}

model QuestionBank {
  id             String          @id @default(cuid())
  topic          String
  prompt         String
  type           QuestionType    @default(FIXED)
  difficulty     DifficultyLevel @default(MID_LEVEL)
  seniorityLevel SeniorityLevel?
  sourceType     SourceType      @default(MANUAL)
  tagsJson       Json?
  aiMetadataJson Json?
  metadataJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviewQuestions InterviewQuestion[]

  @@index([topic])
  @@index([difficulty])
}

model InterviewQuestion {
  id             String  @id @default(cuid())
  interviewId    String
  questionBankId String?

  order          Int
  topic          String?
  questionText   String
  type           QuestionType    @default(FIXED)
  difficulty     DifficultyLevel @default(MID_LEVEL)
  tagsJson       Json?
  aiMetadataJson Json?
  metadataJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview    Interview                    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionBank QuestionBank?                @relation(fields: [questionBankId], references: [id], onDelete: SetNull)
  evaluation   InterviewQuestionEvaluation?

  @@unique([interviewId, order])
  @@index([interviewId])
}

model InterviewQuestionEvaluation {
  id                  String  @id @default(cuid())
  interviewQuestionId String  @unique
  score               Int?
  notesText           String?
  aiMetadataJson      Json?
  metadataJson        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviewQuestion InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Cascade)
}

model EvaluationScorecard {
  id             String          @id @default(cuid())
  interviewId    String          @unique
  recommendation Recommendation?
  overallScore   Float?
  summaryText    String?
  scorecardJson  Json?
  aiMetadataJson Json?
  metadataJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model Report {
  id             String     @id @default(cuid())
  interviewId    String
  type           ReportType @default(FEEDBACK)
  title          String
  reportJson     Json
  aiMetadataJson Json?
  metadataJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([type])
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType @default(SYSTEM)
  priority     Priority         @default(MEDIUM)
  title        String
  message      String?
  readAt       DateTime?
  metadataJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([type])
}

model AuditLog {
  id           String  @id @default(cuid())
  userId       String
  action       String
  entityType   String
  entityId     String?
  ipAddress    String?
  userAgent    String?
  metadataJson Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
}

model AppSetting {
  id           String  @id @default(cuid())
  key          String  @unique
  settingValue Json
  description  String?
  isSystem     Boolean @default(false)
  updatedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedBy User? @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([key])
}
